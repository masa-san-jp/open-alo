{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-alo.org/schema/alo-0.1.schema.json",
  "title": "Open ALO Draft 0.1",
  "description": "JSON Schema for an Open ALO source document. YAML ALO files are parsed into the same data model before validation.",
  "type": "object",
  "required": ["alo"],
  "additionalProperties": false,
  "properties": {
    "alo": {"$ref": "#/$defs/alo"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "jsonValue": {},
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*(\\.[A-Za-z][A-Za-z0-9_.-]*)*$"
    },
    "fieldType": {
      "type": "string",
      "enum": ["string", "integer", "number", "boolean", "object", "array", "enum"]
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/fieldType"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "number", "boolean", "null"]}
        },
        "items": {"$ref": "#/$defs/field"},
        "properties": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/field"}
        },
        "required": {"type": "boolean"},
        "default": {"$ref": "#/$defs/jsonValue"},
        "initial": {"$ref": "#/$defs/jsonValue"},
        "updated_by": {"$ref": "#/$defs/nonEmptyString"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "enum"}}},
          "then": {"required": ["values"]},
          "else": {"not": {"required": ["values"]}}
        },
        {
          "if": {"properties": {"type": {"const": "array"}}},
          "then": {"required": ["items"]},
          "else": {"not": {"required": ["items"]}}
        }
      ]
    },
    "inputField": {
      "allOf": [
        {"$ref": "#/$defs/field"},
        {"required": ["required"]}
      ]
    },
    "stateField": {
      "allOf": [
        {"$ref": "#/$defs/field"},
        {"required": ["initial", "updated_by"]}
      ]
    },
    "outputField": {"$ref": "#/$defs/field"},
    "reads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "binaryDecision": {
      "type": "object",
      "required": ["id", "type", "reads", "question"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "binary"},
        "reads": {"$ref": "#/$defs/reads"},
        "question": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "categoricalDecision": {
      "type": "object",
      "required": ["id", "type", "reads", "question", "options"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "categorical"},
        "reads": {"$ref": "#/$defs/reads"},
        "question": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "options": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "scalarDecision": {
      "type": "object",
      "required": ["id", "type", "reads", "question", "scale"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "scalar"},
        "reads": {"$ref": "#/$defs/reads"},
        "question": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "scale": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"},
            "unit": {"$ref": "#/$defs/nonEmptyString"},
            "description": {"$ref": "#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "decision": {
      "oneOf": [
        {"$ref": "#/$defs/binaryDecision"},
        {"$ref": "#/$defs/categoricalDecision"},
        {"$ref": "#/$defs/scalarDecision"}
      ]
    },
    "derivedValue": {
      "type": "object",
      "required": ["expression"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/fieldType"},
        "expression": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "transitionRule": {
      "type": "object",
      "required": ["id", "priority", "when", "set"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "priority": {"type": "integer"},
        "when": {"$ref": "#/$defs/nonEmptyString"},
        "set": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        },
        "stop_condition": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "alo": {
      "type": "object",
      "required": [
        "spec_version",
        "id",
        "version",
        "purpose",
        "inputs",
        "state_schema",
        "decisions",
        "transition_rules",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "spec_version": {"const": "0.1"},
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "scope": {"$ref": "#/$defs/nonEmptyString"},
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/inputField"}
        },
        "objects": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"type": "object"}
        },
        "state_schema": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/stateField"}
        },
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/decision"}
        },
        "derived_values": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/derivedValue"}
        },
        "thresholds": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "transition_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/transitionRule"}
        },
        "outputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/outputField"}
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    }
  }
}
