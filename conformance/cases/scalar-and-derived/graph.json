{
  "edges": [
    {
      "from": "decision.risk_score",
      "id": "gates:decision.risk_score->rule.approve",
      "to": "rule.approve",
      "type": "GATES"
    },
    {
      "from": "derived.doubled_amount",
      "id": "reads:derived.doubled_amount->decision.risk_score",
      "to": "decision.risk_score",
      "type": "READS"
    },
    {
      "from": "input.kind",
      "id": "gates:input.kind->rule.approve",
      "to": "rule.approve",
      "type": "GATES"
    },
    {
      "from": "rule.approve",
      "id": "updates:rule.approve->state.score",
      "to": "state.score",
      "type": "UPDATES"
    },
    {
      "from": "rule.approve",
      "id": "updates:rule.approve->state.status",
      "to": "state.status",
      "type": "UPDATES"
    },
    {
      "from": "rule.approve",
      "id": "stops:rule.approve->stop.complete",
      "to": "stop.complete",
      "type": "STOPS"
    },
    {
      "from": "rule.review",
      "id": "updates:rule.review->state.score",
      "to": "state.score",
      "type": "UPDATES"
    },
    {
      "from": "rule.review",
      "id": "updates:rule.review->state.status",
      "to": "state.status",
      "type": "UPDATES"
    }
  ],
  "graph_ir_version": "0.1",
  "nodes": [
    {
      "data": {
        "name": "amount",
        "schema": {
          "required": true,
          "type": "number"
        }
      },
      "id": "input.amount",
      "type": "INPUT"
    },
    {
      "data": {
        "name": "kind",
        "schema": {
          "default": "normal",
          "required": false,
          "type": "enum",
          "values": [
            "normal",
            "urgent"
          ]
        }
      },
      "id": "input.kind",
      "type": "INPUT"
    },
    {
      "data": {
        "name": "score",
        "schema": {
          "initial": 0,
          "type": "number",
          "updated_by": "rule_engine"
        }
      },
      "id": "state.score",
      "type": "STATE"
    },
    {
      "data": {
        "name": "status",
        "schema": {
          "initial": "new",
          "type": "enum",
          "updated_by": "rule_engine",
          "values": [
            "new",
            "approved",
            "review"
          ]
        }
      },
      "id": "state.status",
      "type": "STATE"
    },
    {
      "data": {
        "expression": "input.amount * 2",
        "name": "doubled_amount",
        "type": "number"
      },
      "id": "derived.doubled_amount",
      "type": "DERIVE"
    },
    {
      "data": {
        "decision_type": "scalar",
        "name": "risk_score",
        "question": "What is the risk score for this amount?",
        "reads": [
          "derived.doubled_amount"
        ],
        "scale": {
          "max": 100,
          "min": 0
        }
      },
      "id": "decision.risk_score",
      "type": "DECISION_SCALAR"
    },
    {
      "data": {
        "name": "approve",
        "priority": 10,
        "set": {
          "score": 100,
          "status": "approved"
        },
        "stop_condition": "complete",
        "when": "decision.risk_score.score >= 70 and input.kind == 'normal'"
      },
      "id": "rule.approve",
      "type": "RULE"
    },
    {
      "data": {
        "name": "review",
        "priority": 20,
        "set": {
          "score": 0,
          "status": "review"
        },
        "when": "no_previous_rule_matched"
      },
      "id": "rule.review",
      "type": "RULE"
    },
    {
      "data": {
        "name": "action",
        "schema": {
          "type": "string"
        }
      },
      "id": "output.action",
      "type": "OUTPUT"
    },
    {
      "data": {
        "condition": "complete"
      },
      "id": "stop.complete",
      "type": "STOP"
    }
  ],
  "source": {
    "alo_id": "scalar-and-derived",
    "alo_version": "0.1.0",
    "spec_version": "0.1"
  }
}
